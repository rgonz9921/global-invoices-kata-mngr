# Copia este archivo a .env y rellena los valores reales.
# .env esta gitignoreado — NUNCA se versiona.
# spring-dotenv carga estas variables al arrancar la app en local / IDE.

# Perfil activo: dev | prod
SPRING_PROFILES_ACTIVE=dev

# --- MongoDB Atlas ---
# Connection string del cluster M0 (Atlas > Connect > Drivers).
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=global_invoices

# --- JWT ---
# Clave HMAC en Base64, minimo 256 bits. Generar con:
#   openssl rand -base64 48
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_BASE64_DE_48_BYTES
JWT_EXPIRATION_MS=3600000

# --- CORS ---
# Origenes permitidos, separados por coma. En prod: el dominio de Netlify.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Usuarios semilla (solo dev) ---
APP_SEED_ENABLED=true
SEED_OPERADOR_NAME=Operador Demo
SEED_OPERADOR_EMAIL=operador@globalinvoice.com
SEED_OPERADOR_PASSWORD=Operador123!
SEED_AUDITOR_NAME=Auditor Demo
SEED_AUDITOR_EMAIL=auditor@globalinvoice.com
SEED_AUDITOR_PASSWORD=Auditor123!
